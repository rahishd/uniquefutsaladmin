generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  phoneNumber          String                   @id
  email                String?                  @unique
  password             String
  name                 String?
  role                 String                   @default("user")
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  avatar               String?
  freeMatchesAvailable Int                      @default(0)
  isVerified           Boolean                  @default(false)
  loyaltyEligible      Boolean                  @default(false)
  loyaltyProgress      Int                      @default(0)
  googleSub            String?                  @unique
  googleEmail          String?
  bookings             Booking[]
  subscriptions        MembershipSubscription[]
  notifications        Notification[]
  orders               Order[]
  reviews              Review[]
  transactions         Transaction[]
}

model Product {
  id                String         @id @default(cuid())
  name              String
  description       String?
  price             Float
  categoryId        String
  inventory         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lowStockThreshold Int            @default(10)
  unit              String         @default("pcs")
  costPrice         Float?
  logs              InventoryLog[]
  orderItems        OrderItem[]
  category          Category       @relation(fields: [categoryId], references: [id])
  reviews           Review[]
}

model InventoryLog {
  id           String   @id @default(cuid())
  productId    String
  change       Int
  price        Float?
  reason       String?
  createdAt    DateTime @default(now())
  cashAmount   Float    @default(0)
  onlineAmount Float    @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Order {
  id          String       @id @default(cuid())
  userId      String
  totalPrice  Float
  status      String       @default("pending")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [phoneNumber])
  items       OrderItem[]
  payment     Payment?
  transaction Transaction?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  amount        Float
  status        String   @default("pending")
  paymentMethod String?
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  orderId     String?  @unique
  amount      Float
  type        String
  description String?
  createdAt   DateTime @default(now())
  order       Order?   @relation(fields: [orderId], references: [id])
  user        User     @relation(fields: [userId], references: [phoneNumber])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [phoneNumber])

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("general")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  href      String?
  dedupeKey String?  @unique
  user      User     @relation(fields: [userId], references: [phoneNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  changes   String?
  userId    String?
  createdAt DateTime @default(now())
}

model Booking {
  id               String    @id @default(cuid())
  userId           String?
  date             String
  startTime        String
  endTime          String
  duration         Int
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  basePrice        Float
  addOns           String?
  addOnsPrice      Float     @default(0)
  promoCode        String?
  discountAmount   Float     @default(0)
  subtotal         Float
  totalPrice       Float
  paymentMethod    String
  amountPaidNow    Float     @default(0)
  remainingAmount  Float     @default(0)
  paymentStatus    String    @default("pending")
  status           String    @default("pending")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  cashAmount       Float     @default(0)
  onlineAmount     Float     @default(0)
  waterBottles     Int       @default(0)
  clubDiscount     Int       @default(0) // Unique Club discount included in discountAmount
  loyaltyEnabled   Boolean   @default(true)
  source           String    @default("regular")
  challengeId      String?
  voucherId        String?
  cancelledAt      DateTime?
  holdExpiresAt    DateTime?
  checkedInAt      DateTime?
  paymentOrderCode String?
  code             String?
  user             User?     @relation(fields: [userId], references: [phoneNumber])

  @@index([userId])
  @@index([date])
  @@index([customerPhone])
  @@index([code])
  @@index([status])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  itemName  String
  category  String
  quantity  String?
  price     Float
  date      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tournament {
  id            String         @id @default(cuid())
  name          String
  prizePool     Float
  minTeams      Int
  maxTeams      Int
  startDate     String
  endDate       String
  isActive      Boolean        @default(true)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?
  paymentStatus String         @default("unpaid")
  status        String         @default("active")
  totalAmount   Float          @default(0)
  hostedEvent   Boolean        @default(false)
  entryFee      Float          @default(0)
  hostName      String?
  hostPhone     String?
  minRate       Int?
  billClosedAt  DateTime?
  createdBy     String?
  days          TournamentDay[]
  registrations Registration[]
  billLines     TournamentBillLine[]
  payments      TournamentPayment[]
}

model TournamentDay {
  id           String     @id @default(cuid())
  tournamentId String
  date         String
  startHour    Int
  endHour      Int
  blockIds     String[]
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, date])
}

model TournamentBillLine {
  id           String     @id @default(cuid())
  tournamentId String
  kind         String // goods | extra | discount
  label        String
  productId    String?
  quantity     Int        @default(1)
  unitPrice    Int        @default(0)
  amount       Int // a discount is negative
  createdBy    String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

model TournamentPayment {
  id           String     @id @default(cuid())
  tournamentId String
  cash         Int        @default(0)
  fonepay      Int        @default(0)
  note         String?
  receivedBy   String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

model Registration {
  id           String     @id @default(cuid())
  tournamentId String
  teamName     String
  captainName  String
  contactEmail String
  contactPhone String
  players      String
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model GamezoneRecord {
  id           String   @id @default(cuid())
  customerName String
  hours        Float
  rate         Float
  money        Float
  date         String
  timestamp    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MembershipPlan {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  price                  Float
  perks                  String
  featured               Boolean                  @default(false)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  pricingMatrix          String?
  price1MonthDay         Int?
  price1MonthEvening     Int?
  price1MonthMorning     Int?
  price3DaysDay          Int?
  price3DaysEvening      Int?
  price3DaysMorning      Int?
  price3MonthsDay        Int?
  price3MonthsEvening    Int?
  price3MonthsMorning    Int?
  discount1MonthDay      Int?                     @default(0)
  discount1MonthEvening  Int?                     @default(0)
  discount1MonthMorning  Int?                     @default(0)
  discount3DaysDay       Int?                     @default(0)
  discount3DaysEvening   Int?                     @default(0)
  discount3DaysMorning   Int?                     @default(0)
  discount3MonthsDay     Int?                     @default(0)
  discount3MonthsEvening Int?                     @default(0)
  discount3MonthsMorning Int?                     @default(0)
  // ADMIN ADDITION (sql/002_membership_6_months.sql): the customer schema needs the same six columns before it can offer 6 months
  price6MonthsDay        Int?
  price6MonthsEvening    Int?
  price6MonthsMorning    Int?
  discount6MonthsDay     Int?                     @default(0)
  discount6MonthsEvening Int?                     @default(0)
  discount6MonthsMorning Int?                     @default(0)
  subscriptions          MembershipSubscription[]
}

model MembershipSubscription {
  id                String         @id @default(cuid())
  planId            String
  userId            String
  startDate         DateTime
  endDate           DateTime
  status            String         @default("pending")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paymentStatus     String         @default("pending")
  paymentVerifiedAt DateTime?
  paymentVerifiedBy String?
  timeSlot          String?
  chosenCategory    String?
  chosenDuration    String?
  totalPrice        Float?
  chosenDays        String[]
  discountAmount    Float          @default(0)
  promoCode         String?
  notes             String?
  excludeDays       String[]
  memberCode        String?        @unique
  plan              MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [phoneNumber])
}

model SuperAdmin {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Ad {
  id        String   @id @default(cuid())
  image     String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  image       String
  title       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserOTP {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  otp         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model PendingSignup {
  phoneNumber String   @id
  name        String
  email       String?
  password    String
  otp         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model PageVisit {
  id        String   @id @default(cuid())
  date      String
  page      String   @default("/")
  userAgent String?
  createdAt DateTime @default(now())
}

// ===================================================================
// New customer app (additive only: new tables, no changes to old data).
// User references below are phone numbers (User.phoneNumber), kept as plain strings.
// ===================================================================

model UserPrefs {
  userId             String   @id
  smsReminders       Boolean  @default(true)
  promoNotifications Boolean  @default(true)
  popupReminder      Boolean  @default(true)
  language           String   @default("en")
  mode               String   @default("player") // player | captain
  location           String?
  position           String? // GK | DEF | MID | FWD
  updatedAt          DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PaymentOrder {
  id         String    @id @default(cuid())
  orderCode  String    @unique // the booking / gamezone / membership code shown to the customer
  purpose    String // game | gamezone | purchase | renew
  userId     String?
  guestPhone String?
  method     String // esewa | fonepay | venue
  amount     Int
  status     String    @default("pending") // pending | paid | expired | failed | refunded
  remarks    String
  qrPayload  String?
  gatewayRef String?
  expiresAt  DateTime
  paidAt     DateTime?
  paidBy     String? // staff id for venue payments
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  orderCode  String
  source     String // gateway | staff | system
  payload    String
  receivedAt DateTime @default(now())

  @@index([orderCode])
}

model LoyaltyEntry {
  id         String   @id @default(cuid())
  userId     String
  kind       String // game | captain_win | goods | membership | free_game
  points     Decimal  @db.Decimal(8, 1) // positive = earned, negative = spent on a free game
  earnedOn   String // YYYY-MM-DD
  expiresOn  String? // last valid day; null = never expires
  sourceType String
  sourceId   String
  detail     String
  createdAt  DateTime @default(now())

  @@unique([kind, sourceType, sourceId])
  @@index([userId])
}

model FreeGameVoucher {
  id        String    @id @default(cuid())
  userId    String
  period    String // Morning | Day | Evening
  cost      Decimal   @db.Decimal(8, 1)
  status    String    @default("unused") // unused | used | void
  bookingId String?
  claimedAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId, status])
}

model GoodsSale {
  id     String   @id @default(cuid())
  userId String?
  phone  String?
  amount Int
  items  String?
  soldBy String
  customerName String?
  bookingId    String?
  soldAt DateTime @default(now())
}

model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  area      String       @default("Tilottama")
  captainId String       @unique
  createdAt DateTime     @default(now())
  members   TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String   @unique // a player can be in only one team
  position String   @default("MID")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Challenge {
  id               String            @id @default(cuid())
  challengerTeamId String
  challengedTeamId String
  type             String // match | competition
  date             String
  startHour        Int
  courtPrice       Int
  loserPct         Int // 70 | 60 | 100
  message          String?
  status           String            @default("pending") // pending | accepted | declined | cancelled | expired
  bookingId        String?
  venuePaidAt      DateTime?
  venuePaidBy      String?
  createdAt        DateTime          @default(now())
  results          ChallengeResult[]

  @@index([challengerTeamId])
  @@index([challengedTeamId])
}

model ChallengeResult {
  id                String    @id @default(cuid())
  challengeId       String
  submittedByTeamId String
  scoreSubmitter    Int
  scoreOther        Int
  status            String    @default("awaiting_approval") // awaiting_approval | approved | disputed
  approvedBy        String?
  resolutionNote    String?
  createdAt         DateTime  @default(now())
  challenge         Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model ChallengePrompt {
  challengeId String
  userId      String
  shownAt     DateTime @default(now())

  @@id([challengeId, userId])
}

model GzConsole {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
}

model GzGame {
  id     String  @id @default(cuid())
  title  String  @unique
  active Boolean @default(true)
}

model GzPlan {
  players           Int    @id // 1 | 2 | 4
  label             String
  ratePerPersonHour Int
}

model GzBooking {
  id            String    @id @default(cuid())
  code          String    @unique
  userId        String?
  guestName     String?
  guestPhone    String?
  consoleId     String
  gameTitle     String
  date          String
  startHour     Int
  hours         Int
  players       Int
  total         Int
  clubDiscount  Int       @default(0) // Unique Club discount already taken off total
  paymentMethod String
  paymentStatus String    @default("pending") // pending | pay_at_venue | paid | refunded
  status        String    @default("confirmed") // confirmed | completed | cancelled | expired
  holdExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([consoleId, date])
  @@index([userId])
}

model ArrivalCheckin {
  refId        String    @id // booking id or gamezone code
  userId       String
  confirmedAt  DateTime  @default(now())
  snoozedUntil DateTime?
  alertedAt    DateTime?
}

model TournamentRound {
  id           String            @id @default(cuid())
  tournamentId String
  name         String
  position     Int
  matches      TournamentMatch[]

  @@index([tournamentId])
}

model TournamentMatch {
  id        String          @id @default(cuid())
  roundId   String
  home      String?
  away      String?
  status    String          @default("upcoming") // upcoming | live | finished
  homeScore Int?
  awayScore Int?
  note      String?
  startsAt  DateTime?
  venue     String?
  round     TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  goals     MatchGoal[]
  follows   MatchFollow[]

  @@index([roundId])
}

// Owned by the customer backend (migration 20261017000001_match_follow): customers who asked for live updates of a match.
model MatchFollow {
  id        String          @id @default(cuid())
  userId    String
  matchId   String
  createdAt DateTime        @default(now())
  match     TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

// One goal of a match: which side, the minute and the scorer (both optional). The match score follows the goals staff or the host add.
model MatchGoal {
  id        String          @id @default(cuid())
  matchId   String
  side      String // home | away
  minute    Int?
  scorer    String?
  createdBy String?
  createdAt DateTime        @default(now())
  match     TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

// The private link a match-day host opens (no staff sign-in) to follow goals and update the tie-sheet of ONE tournament.
model TournamentHostLink {
  id           String    @id @default(cuid())
  tournamentId String    @unique
  token        String    @unique
  active       Boolean   @default(true)
  expiresAt    DateTime?
  createdBy    String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
}

// One row per booked hour. The unique (date, hour) is the final guard against two bookings taking the same hour.
model BookingSlot {
  id        String   @id @default(cuid())
  date      String
  hour      Int
  bookingId String
  createdAt DateTime @default(now())

  @@unique([date, hour])
  @@index([bookingId])
}

// One row per console and booked hour: the unique index is the final guard against double booking a console.
model GzSlot {
  id          String @id @default(cuid())
  consoleId   String
  date        String
  hour        Int
  bookingCode String

  @@unique([consoleId, date, hour])
  @@index([bookingCode])
}

model PlayerGameStat {
  id         String   @id @default(cuid())
  bookingId  String
  userId     String
  goals      Int      @default(0)
  assists    Int      @default(0)
  recordedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([bookingId, userId])
  @@index([userId])
}

// Customer complaints (customer backend migration 20261007000001_complaints). Mirrored here; staff read and reply.
model Complaint {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  category    String
  message     String
  bookingCode String?
  photos      String[]  @default([])
  status      String    @default("open") // open | in_review | resolved | closed
  staffReply  String?
  repliedBy   String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

// VIP discount code staff give to ONE customer (customer backend migration 20261009000001_vip_codes).
model VipCode {
  id        String    @id @default(cuid())
  userId    String    @unique
  code      String
  type      String // percent | flat
  value     Int
  active    Boolean   @default(true)
  note      String?
  claimedAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([code])
}

// =====================================================================
// Children's Academy (customer backend migration 20261010000001_children_academy).
model AcademySession {
  id          String              @id @default(cuid())
  title       String              @default("Children's Academy class")
  date        String
  startTime   String
  endTime     String
  capacity    Int                 @default(15)
  coach       String?
  visible     Boolean             @default(true)
  status      String              @default("open") // open | cancelled
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  enrollments AcademyEnrollment[]

  @@index([date, visible])
}

model AcademyEnrollment {
  id              String         @id @default(cuid())
  code            String         @unique
  sessionId       String
  userId          String
  guardianName    String
  guardianPhone   String
  emergencyPhone  String
  address         String
  childName       String
  childKey        String
  childAge        Int
  healthStatus    String // healthy | condition
  healthNotes     String?
  termsVersion    Int
  termsAcceptedAt DateTime
  status          String         @default("confirmed") // confirmed | cancelled | attended | no_show
  cancelledAt     DateTime?
  cancelledBy     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  session         AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, childKey])
  @@index([userId])
  @@index([sessionId, status])
}

// Refer & Earn (customer backend migration 20261011000001_refer_earn).
model Referral {
  id             String    @id @default(cuid())
  code           String    @unique
  referrerId     String
  friendId       String
  teamName       String
  bookingId      String    @unique
  bookingCode    String?
  gameDate       String
  gameTime       String
  status         String    @default("pending") // pending | approved | rejected
  referrerPoints Decimal   @db.Decimal(8, 1)
  friendPoints   Decimal   @db.Decimal(8, 1)
  staffNote      String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([referrerId])
  @@index([friendId])
  @@index([status, createdAt])
}

// Site content: gallery photos and ads (customer backend migration 20261012000001_site_content).
model ContentMedia {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  width     Int
  height    Int
  bytes     Int
  createdBy String
  createdAt DateTime @default(now())
}

model SiteGallery {
  id          String   @id @default(cuid())
  title       String
  caption     String?
  mediaId     String   @unique
  orientation String
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
}

// Corporate Network logos (same table as the customer backend). Managed in the admin portal, shown on the customer Home.
model SitePartner {
  id        String   @id @default(cuid())
  name      String
  mediaId   String   @unique
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
}

model SiteAd {
  id                String   @id @default(cuid())
  title             String
  mediaId           String   @unique
  linkUrl           String?
  placement         String // header | footer | popup | inline
  displaySeconds    Int      @default(6)
  popupDelaySeconds Int      @default(3)
  popupFrequency    String   @default("day")
  startDate         String?
  endDate           String?
  dailyStart        String?
  dailyEnd          String?
  days              Int[]    @default([])
  priority          Int      @default(0)
  active            Boolean  @default(true)
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([placement, active])
}

// Final bill made at the counter (customer backend migration 20261013000001_checkouts).
model Checkout {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  paymentMethod String
  goodsTotal    Int      @default(0)
  gameTotal     Int      @default(0)
  total         Int
  lines         String
  bookingIds    String[] @default([])
  goodsSaleId   String?
  pointsGoods   Decimal  @default(0) @db.Decimal(8, 1)
  pointsGames   Decimal  @default(0) @db.Decimal(8, 1)
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// ADMIN-OWNED TABLES (created by sql/*.sql in production; `npm run db:push` builds them locally).
// Everything above this line mirrors the customer backend's schema: keep it in sync, never edit it here.
// =====================================================================

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String // owner | admin | staff (older: manager | frontdesk | accountant)
  permissions  String[]  @default([]) // what a "staff" account may do; admins have everything
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  sessionVersion Int @default(0) // sign-in tokens carry this number; a password change raises it and so signs everyone out
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  staffId   String
  staffName String
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([staffId])
}

model SlotBlock {
  id        String   @id @default(cuid())
  date      String
  hour      Int
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([date, hour])
}

// Goods given on credit: stock leaves now, the money is collected later together with the games (admin-owned table).
model GoodsDue {
  id           String    @id @default(cuid())
  userId       String // the customer's account (phone)
  saleId       String    @unique // the GoodsSale row made when the goods were given
  amount       Int
  items        String // "5 x Gloves, 20 x Energy drink"
  lines        String // JSON lines as on a bill
  status       String    @default("due") // due | paid
  createdBy    String
  createdAt    DateTime  @default(now())
  paidAt       DateTime?
  paidBy       String?
  checkoutCode String?
  cashAmount   Int       @default(0)
  onlineAmount Int       @default(0)

  @@index([userId, status])
}

// Fonepay dynamic QR made at the counter. A paid QR is used once, for exactly its amount, to settle a bill (admin-owned table).
model FonepayQr {
  id            String    @id @default(cuid())
  prn           String    @unique // payment reference number sent to the gateway
  amount        Int
  remarks       String
  payload       String // the text inside the QR
  providerRef   String?
  purpose       String    @default("counter")
  customerPhone String?
  status        String    @default("pending") // pending | paid | failed | expired
  note          String?
  createdBy     String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  paidAt        DateTime?
  paidReference String?
  consumedAt    DateTime? // set when a bill used this payment
  consumedFor   String? // the bill code

  @@index([status, createdAt])
}

// Digital ID: the random value inside a customer's QR (same table as the customer backend, migration 20261015000001).
model DigitalId {
  userId    String    @id
  token     String    @unique
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
}

// Membership attendance: one row per member per day, recorded by staff after scanning the member's Digital ID. Admin-owned.
model MembershipAttendance {
  id             String   @id @default(cuid())
  subscriptionId String
  userId         String
  date           String // YYYY-MM-DD, Nepal time
  recordedBy     String
  createdAt      DateTime @default(now())

  @@unique([subscriptionId, date])
  @@index([userId, date])
}

// Owned by the customer backend (migration 20261016000001_site_visits). One row per visitor per Nepal day, anonymous.
model SiteVisit {
  id         String   @id @default(cuid())
  day        String
  visitor    String
  registered Boolean  @default(false)
  pages      Int      @default(1)
  firstAt    DateTime @default(now())
  lastAt     DateTime @default(now())

  @@unique([day, visitor])
  @@index([day])
}

// Chat between registered customers: one to one ("direct") or a group. Members are User.phoneNumber values.
model ChatThread {
  id            String        @id @default(cuid())
  kind          String // direct | group
  name          String? // groups only
  directKey     String?       @unique // "phoneA|phoneB" (sorted), direct chats only: one thread per pair
  inviteCode    String?       @unique // groups only: the code in the share link
  createdBy     String
  lastMessage   String?
  lastSenderId  String?
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  members       ChatMember[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
}

model ChatMember {
  id         String     @id @default(cuid())
  threadId   String
  userId     String
  role       String     @default("member") // admin | member
  lastReadAt DateTime   @default(now())
  joinedAt   DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// Find Player: someone asks for more players for a game ("I need 6 players"). Every registered customer is notified;
// they tap "I'm in" to join until the spots are full.
model PlayerRequest {
  id            String              @id @default(cuid())
  userId        String // poster, User.phoneNumber
  date          String // YYYY-MM-DD
  startHour     Int
  playersNeeded Int
  note          String?
  status        String              @default("open") // open | awaiting_advance | confirmed | cancelled
  courtPrice    Int                 @default(0) // the court price for that hour when it was posted
  bookingId     String? // the court booking made when the host pays the advance
  advanceDueAt  DateTime? // once everyone has joined, the host has until then to pay the advance
  createdAt     DateTime            @default(now())
  joins         PlayerRequestJoin[]

  @@index([date, status])
  @@index([userId, createdAt])
}

model PlayerRequestJoin {
  id        String        @id @default(cuid())
  requestId String
  userId    String // User.phoneNumber
  createdAt DateTime      @default(now())
  request   PlayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([userId])
}

// Unique Club: Rs. 1,500 for 30 days, 10% off court bookings, Gamezone and hosted tournaments. Promo and VIP codes are
// not used with it. A member is active while validUntil is in the future.
model ClubMember {
  id         String   @id @default(cuid())
  userId     String   @unique // User.phoneNumber
  validUntil DateTime
  startedAt  DateTime @default(now())
  lastPaidAt DateTime @default(now())
  payments   Int      @default(1) // how many monthly payments so far
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([validUntil])
}

// Unique Goal Rush: a 5-shot penalty game against a goalkeeper the server plays. Up to 3 games a day (every game started
// counts); a finished game with at least one goal earns 2 loyalty points (a LoyaltyEntry of kind goal_rush, one per game).
model GoalRushGame {
  id         String         @id @default(cuid())
  userId     String // User.phoneNumber
  day        String // YYYY-MM-DD (Nepal time): the day the game counts for
  status     String         @default("active") // active | completed | abandoned
  shotsTaken Int            @default(0)
  goals      Int            @default(0)
  saves      Int            @default(0)
  misses     Int            @default(0) // wide, over the bar or off the post
  points     Int            @default(0) // loyalty points this game earned (0 or 2)
  rewardId   String? // LoyaltyEntry.id of the reward
  startedAt  DateTime       @default(now())
  lastShotAt DateTime?
  finishedAt DateTime?
  shots      GoalRushShot[]

  @@index([userId, day])
  @@index([status, startedAt])
  @@index([day])
}

model GoalRushShot {
  id        String       @id @default(cuid())
  gameId    String
  no        Int // 1..5
  aimX      Float // where the player aimed (goal units: -1..1 between the posts, 0..1 up to the bar)
  aimY      Float
  power     Float // 0..1
  ballX     Float // where the ball actually went (decided by the server)
  ballY     Float
  keeper    String // the zone the goalkeeper dived to: TL TC TR BL BC BR
  outcome   String // goal | save | wide | over | post
  createdAt DateTime     @default(now())
  game      GoalRushGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, no])
}

// Collect Service Payment (admin portal): money set aside for a purpose. A "percent" fund (the 3% Charity Fund) accrues from
// the takings; a "manual" fund (maintenance, balls ...) only has what staff deposit. Deposits are written once, never edited.
model ServiceFund {
  id            String           @id @default(cuid())
  name          String           @unique
  kind          String // percent | manual
  rate          Float? // percent funds: % of the takings
  defaultAmount Int? // manual funds: the amount the Deposit button suggests
  note          String?
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdBy     String
  createdAt     DateTime         @default(now())
  deposits      ServiceDeposit[]
}

model ServiceDeposit {
  id            String      @id @default(cuid())
  fundId        String
  amount        Float
  note          String?
  depositedOn   String // YYYY-MM-DD, Nepal time
  createdBy     String // staff id
  createdByName String
  createdAt     DateTime    @default(now())
  fund          ServiceFund @relation(fields: [fundId], references: [id])

  @@index([fundId, depositedOn])
  @@index([depositedOn])
}

// Gift Card (customer app, migration 20261029000001_gift_cards in the client backend): points or a game bought for a friend.
model Gift {
  id        String    @id @default(cuid())
  code      String    @unique
  kind      String // points | game
  buyerId   String
  friendId  String
  points    Int?
  bookingId String?   @unique
  amount    Int
  message   String?
  status    String    @default("pending") // pending | paid | expired | refunded
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([buyerId, createdAt])
  @@index([friendId])
}
