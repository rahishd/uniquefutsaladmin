# Copy to .env. NEVER commit .env. NEVER paste production values into this file.
NODE_ENV=development
PORT=5100

# Same database as the customer backend. Outside production this MUST be a local host (the server refuses otherwise).
DATABASE_URL=postgresql://unique:unique_dev_pw@localhost:5441/unique_dev?schema=public

# Admin-only signing secret, different from the customer JWT secret. Random, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE=12h

# Comma separated admin web origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Used only by `npm run create-owner` (first owner account)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner

# Web Push for notices staff send. Use the SAME VAPID keys as the customer backend (backend/.env). Empty = bell only, no push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Mass texts and login-detail texts from the SMS page are sent by THIS server, with the same gateway as the customer backend.
# SMS_PROVIDER: "android" (SMS Gateway for Android, cloud mode) or "sparrow". Use the same SMSGATE_* values as the customer backend.
SMS_PROVIDER=sparrow
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_SIM=0
SMSGATE_TTL_SECONDS=86400
SPARROW_SMS_TOKEN=
SPARROW_SMS_IDENTITY=
# The address customers open the app at (put in the login-details text)
CUSTOMER_APP_URL=https://www.uniquefutsal.com
