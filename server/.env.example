# Copy to .env. NEVER commit .env. NEVER paste production values into this file.
NODE_ENV=development
PORT=5100

# Same database as the customer backend. Outside production this MUST be a local host (the server refuses otherwise).
DATABASE_URL=postgresql://unique:unique_dev_pw@localhost:5441/unique_dev?schema=public

# Admin-only signing secret, different from the customer JWT secret. Random, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE=12h

# Comma separated admin web origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Used only by `npm run create-owner` (first owner account)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner

# Fonepay dynamic QR. "test" = fake QR with a simulate button (development). "live" = the real Fonepay API (production; fill the three values).
FONEPAY_MODE=test
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET=
FONEPAY_BASE_URL=
FONEPAY_QR_TTL_MINUTES=10
